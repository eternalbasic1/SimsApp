# Copy to android/keystore.properties (gitignored) and set your upload key paths/passwords.
# See docs/android-play-store-release.md

# Keystore file path is relative to android/app/ (e.g. android/upload-keystore.jks)
storeFile=../upload-keystore.jks
storePassword=REPLACE_ME
keyAlias=upload
keyPassword=REPLACE_ME